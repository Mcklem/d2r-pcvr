#include <D2RLPlugin/resource.h>
#include <D2RLPlugin/version.h>
#include "pcvr_identity.h"

D2RL_PLUGIN_MANIFEST_RESOURCE_ID RCDATA { D2RL_PLUGIN_RESOURCE_DWORD(D2RL_PLUGIN_ABI_VERSION) }

// Who this DLL is, for Windows' file properties, support logs and installers
// that look before they replace anything: D2R PCVR, not D2R VR (whose plugin is
// d2rl-vrcam.dll). D2RLoader reads the manifest above, not this block.
// Numeric flags instead of <winver.h> names keep this independent of the SDK.
1 VERSIONINFO
 FILEVERSION D2RPCVR_VERSION_RC
 PRODUCTVERSION D2RPCVR_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", D2RPCVR_AUTHOR
            VALUE "FileDescription", "D2R PCVR - the VR layer (a D2RLoader plugin)"
            VALUE "FileVersion", D2RPCVR_VERSION
            VALUE "InternalName", D2RPCVR_MOD_ID
            VALUE "LegalCopyright", "MPL-2.0 licence. D2R PCVR contributors; based on D2R VR, copyright (c) 2026 BodyWalkVR, MIT."
            VALUE "OriginalFilename", D2RPCVR_PLUGIN_FILE
            VALUE "ProductName", D2RPCVR_NAME
            VALUE "ProductVersion", D2RPCVR_VERSION
            VALUE "Comments", D2RPCVR_RC_COMMENTS
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
